# Copy to .env (gitignored) and fill in your seat's credentials.
# Never commit real values -- every write is attributed to whoever is signed in.

# Suryodaya (India) — the harness's `--tenant in`, and the default for tests.
AGENTSWITCH_BASE_URL=https://agentswitch.theschoolofai.in
AGENTSWITCH_EMAIL=teamNN@theschoolofai.in
AGENTSWITCH_PASSWORD=

# Keystone (US) — the harness's `--tenant us` (harness/__main__.py ENV_PREFIX).
US_AGENTSWITCH_BASE_URL=https://class.agentswitch.theschoolofai.in
US_AGENTSWITCH_EMAIL=teamNN@theschoolofai.in
US_AGENTSWITCH_PASSWORD=

# LLM gateway for `aptax ask` (agent_design.md §4.11): glc_v5 running as its own service.
APTAX_LLM=aptax.llm.glc:factory
GLC_BASE_URL=http://127.0.0.1:8111
GLC_PROVIDER=gemini
GLC_TIMEOUT=120
